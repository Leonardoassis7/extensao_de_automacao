{
  "manifest_version": 3,
  "name": "PreencheJa",
  "version": "1.0",
  "description": "Automacao simples",
  "permissions": ["storage", "activeTab", "sidePanel"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PreencheJa"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "all_frames": true,
    "js": ["content.js"]
  }]
}
